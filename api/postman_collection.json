{
	"info": {
		"name": "POS System - Callejon Bar API",
		"description": "Go REST API for Callejon Bar POS System.\n\nBase URL: {{base_url}}\n\nAuth: JWT Bearer tokens. Login first, then use {{token}} variable automatically.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "base_url", "value": "http://localhost:8081/api/pos/v1" },
		{ "key": "token", "value": "" },
		{ "key": "refresh_token", "value": "" }
	],
	"auth": {
		"type": "bearer",
		"bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Login",
					"event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["var jsonData = pm.response.json();", "if (jsonData.access_token) {", "    pm.collectionVariables.set('token', jsonData.access_token);", "    pm.collectionVariables.set('refresh_token', jsonData.refresh_token);", "}"] } }],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n    \"usuario\": \"admin\",\n    \"password\": \"admin123\"\n}" },
						"url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
					}
				},
				{
					"name": "Refresh Token",
					"event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["var jsonData = pm.response.json();", "if (jsonData.access_token) {", "    pm.collectionVariables.set('token', jsonData.access_token);", "    pm.collectionVariables.set('refresh_token', jsonData.refresh_token);", "}"] } }],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n    \"refresh_token\": \"{{refresh_token}}\"\n}" },
						"url": { "raw": "{{base_url}}/auth/refresh", "host": ["{{base_url}}"], "path": ["auth", "refresh"] }
					}
				}
			]
		},
		{
			"name": "Health",
			"item": [
				{
					"name": "Health Check",
					"request": { "auth": { "type": "noauth" }, "method": "GET", "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] } }
				}
			]
		},
		{
			"name": "Users (Admin)",
			"item": [
				{ "name": "List Users", "request": { "method": "GET", "url": { "raw": "{{base_url}}/users", "host": ["{{base_url}}"], "path": ["users"] } } },
				{ "name": "Get User by ID", "request": { "method": "GET", "url": { "raw": "{{base_url}}/users/1", "host": ["{{base_url}}"], "path": ["users", "1"] } } },
				{ "name": "Create User", "request": { "method": "POST", "body": { "mode": "formdata", "formdata": [{ "key": "usuario", "value": "nuevo_user", "type": "text" }, { "key": "password", "value": "password123", "type": "text" }, { "key": "nombre", "value": "Nuevo Usuario", "type": "text" }, { "key": "perfil", "value": "Vendedor", "type": "text" }, { "key": "foto", "type": "file", "src": "", "disabled": true }] }, "url": { "raw": "{{base_url}}/users", "host": ["{{base_url}}"], "path": ["users"] } } },
				{ "name": "Update User", "request": { "method": "PUT", "body": { "mode": "formdata", "formdata": [{ "key": "usuario", "value": "updated_user", "type": "text" }, { "key": "nombre", "value": "Usuario Actualizado", "type": "text" }, { "key": "perfil", "value": "Vendedor", "type": "text" }, { "key": "foto", "type": "file", "src": "", "disabled": true }] }, "url": { "raw": "{{base_url}}/users/1", "host": ["{{base_url}}"], "path": ["users", "1"] } } },
				{ "name": "Delete User", "request": { "method": "DELETE", "url": { "raw": "{{base_url}}/users/1", "host": ["{{base_url}}"], "path": ["users", "1"] } } }
			]
		},
		{
			"name": "Categories (Admin)",
			"item": [
				{ "name": "List Categories", "request": { "method": "GET", "url": { "raw": "{{base_url}}/categories", "host": ["{{base_url}}"], "path": ["categories"] } } },
				{ "name": "Get Category by ID", "request": { "method": "GET", "url": { "raw": "{{base_url}}/categories/1", "host": ["{{base_url}}"], "path": ["categories", "1"] } } },
				{ "name": "Create Category", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n    \"nombre\": \"Nueva Categoria\",\n    \"descripcion\": \"Descripcion de la categoria\"\n}" }, "url": { "raw": "{{base_url}}/categories", "host": ["{{base_url}}"], "path": ["categories"] } } },
				{ "name": "Update Category", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n    \"nombre\": \"Categoria Actualizada\",\n    \"descripcion\": \"Nueva descripcion\"\n}" }, "url": { "raw": "{{base_url}}/categories/1", "host": ["{{base_url}}"], "path": ["categories", "1"] } } },
				{ "name": "Delete Category", "request": { "method": "DELETE", "url": { "raw": "{{base_url}}/categories/1", "host": ["{{base_url}}"], "path": ["categories", "1"] } } }
			]
		},
		{
			"name": "Products (Admin + Especial)",
			"item": [
				{ "name": "List Products", "request": { "method": "GET", "url": { "raw": "{{base_url}}/products", "host": ["{{base_url}}"], "path": ["products"] } } },
				{ "name": "List Products by Category", "request": { "method": "GET", "url": { "raw": "{{base_url}}/products?category_id=1", "host": ["{{base_url}}"], "path": ["products"], "query": [{ "key": "category_id", "value": "1" }] } } },
				{ "name": "Get Product by ID", "request": { "method": "GET", "url": { "raw": "{{base_url}}/products/1", "host": ["{{base_url}}"], "path": ["products", "1"] } } },
				{ "name": "Create Product", "request": { "method": "POST", "body": { "mode": "formdata", "formdata": [{ "key": "codigo", "value": "PROD-001", "type": "text" }, { "key": "id_categoria", "value": "1", "type": "text" }, { "key": "descripcion", "value": "Nuevo Producto", "type": "text" }, { "key": "stock", "value": "10", "type": "text" }, { "key": "precio_compra", "value": "5000", "type": "text" }, { "key": "precio_venta", "value": "8000", "type": "text" }, { "key": "imagen", "type": "file", "src": "", "disabled": true }] }, "url": { "raw": "{{base_url}}/products", "host": ["{{base_url}}"], "path": ["products"] } } },
				{ "name": "Update Product", "request": { "method": "PUT", "body": { "mode": "formdata", "formdata": [{ "key": "id_categoria", "value": "1", "type": "text" }, { "key": "descripcion", "value": "Producto Actualizado", "type": "text" }, { "key": "precio_compra", "value": "6000", "type": "text" }, { "key": "precio_venta", "value": "9000", "type": "text" }, { "key": "imagen", "type": "file", "src": "", "disabled": true }] }, "url": { "raw": "{{base_url}}/products/1", "host": ["{{base_url}}"], "path": ["products", "1"] } } },
				{ "name": "Delete Product", "request": { "method": "DELETE", "url": { "raw": "{{base_url}}/products/1", "host": ["{{base_url}}"], "path": ["products", "1"] } } }
			]
		},
		{
			"name": "Clients (Admin + Especial)",
			"item": [
				{ "name": "List Clients", "request": { "method": "GET", "url": { "raw": "{{base_url}}/clients", "host": ["{{base_url}}"], "path": ["clients"] } } },
				{ "name": "Get Client by ID", "request": { "method": "GET", "url": { "raw": "{{base_url}}/clients/1", "host": ["{{base_url}}"], "path": ["clients", "1"] } } },
				{ "name": "Create Client", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n    \"nombre\": \"Juan Perez\",\n    \"documento\": \"1234567890\",\n    \"email\": \"juan@email.com\",\n    \"telefono\": \"3001234567\",\n    \"direccion\": \"Calle 123\",\n    \"fecha_nacimiento\": \"1990-05-15\"\n}" }, "url": { "raw": "{{base_url}}/clients", "host": ["{{base_url}}"], "path": ["clients"] } } },
				{ "name": "Update Client", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n    \"nombre\": \"Juan Perez Actualizado\",\n    \"documento\": \"1234567890\",\n    \"email\": \"juan_new@email.com\",\n    \"telefono\": \"3009876543\",\n    \"direccion\": \"Carrera 456\",\n    \"fecha_nacimiento\": \"1990-05-15\"\n}" }, "url": { "raw": "{{base_url}}/clients/1", "host": ["{{base_url}}"], "path": ["clients", "1"] } } },
				{ "name": "Delete Client", "request": { "method": "DELETE", "url": { "raw": "{{base_url}}/clients/1", "host": ["{{base_url}}"], "path": ["clients", "1"] } } }
			]
		},
		{
			"name": "Sales",
			"item": [
				{ "name": "Create Sale", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n    \"id_cliente\": 1,\n    \"metodo_pago\": \"Efectivo\",\n    \"productos\": [\n        { \"id_producto\": 1, \"cantidad\": 2 },\n        { \"id_producto\": 2, \"cantidad\": 1 }\n    ]\n}" }, "url": { "raw": "{{base_url}}/sales", "host": ["{{base_url}}"], "path": ["sales"] } } },
				{ "name": "List Sales", "request": { "method": "GET", "url": { "raw": "{{base_url}}/sales?page=1&per_page=25", "host": ["{{base_url}}"], "path": ["sales"], "query": [{ "key": "page", "value": "1" }, { "key": "per_page", "value": "25" }, { "key": "start_date", "value": "2026-01-01", "disabled": true }, { "key": "end_date", "value": "2026-12-31", "disabled": true }, { "key": "status", "value": "completada", "disabled": true }, { "key": "user_id", "value": "1", "disabled": true }] } } },
				{ "name": "Get Sale by ID", "request": { "method": "GET", "url": { "raw": "{{base_url}}/sales/1", "host": ["{{base_url}}"], "path": ["sales", "1"] } } },
				{ "name": "Cancel Sale (Admin)", "request": { "method": "PUT", "url": { "raw": "{{base_url}}/sales/1/cancel", "host": ["{{base_url}}"], "path": ["sales", "1", "cancel"] } } }
			]
		},
		{
			"name": "Inventory (Admin + Especial)",
			"item": [
				{ "name": "List Inventory Movements", "request": { "method": "GET", "url": { "raw": "{{base_url}}/inventory?page=1&per_page=25", "host": ["{{base_url}}"], "path": ["inventory"], "query": [{ "key": "page", "value": "1" }, { "key": "per_page", "value": "25" }, { "key": "product_id", "value": "1", "disabled": true }, { "key": "tipo", "value": "entrada", "disabled": true }, { "key": "start_date", "value": "2026-01-01", "disabled": true }, { "key": "end_date", "value": "2026-12-31", "disabled": true }] } } },
				{ "name": "Create Manual Movement", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n    \"id_producto\": 1,\n    \"tipo\": \"entrada\",\n    \"motivo\": \"compra\",\n    \"cantidad\": 10,\n    \"observaciones\": \"Restock de proveedor\"\n}" }, "url": { "raw": "{{base_url}}/inventory", "host": ["{{base_url}}"], "path": ["inventory"] } } }
			]
		},
		{
			"name": "Cash Register",
			"item": [
				{ "name": "Open Cash Register", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n    \"monto_apertura\": 100000\n}" }, "url": { "raw": "{{base_url}}/cashregister/open", "host": ["{{base_url}}"], "path": ["cashregister", "open"] } } },
				{ "name": "Close Cash Register", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n    \"monto_cierre\": 250000\n}" }, "url": { "raw": "{{base_url}}/cashregister/1/close", "host": ["{{base_url}}"], "path": ["cashregister", "1", "close"] } } },
				{ "name": "Get Current Register", "request": { "method": "GET", "url": { "raw": "{{base_url}}/cashregister/current", "host": ["{{base_url}}"], "path": ["cashregister", "current"] } } },
				{ "name": "List All Registers", "request": { "method": "GET", "url": { "raw": "{{base_url}}/cashregister?page=1&per_page=25", "host": ["{{base_url}}"], "path": ["cashregister"], "query": [{ "key": "page", "value": "1" }, { "key": "per_page", "value": "25" }] } } }
			]
		},
		{
			"name": "Dashboard (Admin + Especial)",
			"item": [
				{ "name": "Get KPIs", "request": { "method": "GET", "url": { "raw": "{{base_url}}/dashboard/kpis", "host": ["{{base_url}}"], "path": ["dashboard", "kpis"] } } }
			]
		},
		{
			"name": "Reports (Admin + Especial)",
			"item": [
				{ "name": "Sales Report (JSON)", "request": { "method": "GET", "url": { "raw": "{{base_url}}/reports/sales?start_date=2026-01-01&end_date=2026-12-31", "host": ["{{base_url}}"], "path": ["reports", "sales"], "query": [{ "key": "start_date", "value": "2026-01-01" }, { "key": "end_date", "value": "2026-12-31" }] } } },
				{ "name": "Sales Report (CSV)", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "text/csv" }], "url": { "raw": "{{base_url}}/reports/sales?start_date=2026-01-01&end_date=2026-12-31", "host": ["{{base_url}}"], "path": ["reports", "sales"], "query": [{ "key": "start_date", "value": "2026-01-01" }, { "key": "end_date", "value": "2026-12-31" }] } } },
				{ "name": "Product Report (JSON)", "request": { "method": "GET", "url": { "raw": "{{base_url}}/reports/products?start_date=2026-01-01&end_date=2026-12-31", "host": ["{{base_url}}"], "path": ["reports", "products"], "query": [{ "key": "start_date", "value": "2026-01-01" }, { "key": "end_date", "value": "2026-12-31" }] } } },
				{ "name": "Product Report (CSV)", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "text/csv" }], "url": { "raw": "{{base_url}}/reports/products?start_date=2026-01-01&end_date=2026-12-31", "host": ["{{base_url}}"], "path": ["reports", "products"], "query": [{ "key": "start_date", "value": "2026-01-01" }, { "key": "end_date", "value": "2026-12-31" }] } } },
				{ "name": "Client Report (JSON)", "request": { "method": "GET", "url": { "raw": "{{base_url}}/reports/clients", "host": ["{{base_url}}"], "path": ["reports", "clients"] } } },
				{ "name": "Client Report (CSV)", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "text/csv" }], "url": { "raw": "{{base_url}}/reports/clients", "host": ["{{base_url}}"], "path": ["reports", "clients"] } } }
			]
		}
	]
}
